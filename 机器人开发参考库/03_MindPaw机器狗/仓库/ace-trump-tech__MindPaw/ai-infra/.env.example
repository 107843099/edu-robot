# Gateway access token. Set this and use the same value as the device API Key.
GATEWAY_TOKEN=change-me

# ark, openai-compatible, or mock
AI_PROVIDER=ark
ARK_API_KEY=replace-with-provider-key
ARK_ENDPOINT_ID=ep-xxxxxxxx
UPSTREAM_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# For an OpenAI-compatible local provider:
# AI_PROVIDER=openai-compatible
# UPSTREAM_URL=http://host.docker.internal:11434/v1/chat/completions
# UPSTREAM_API_KEY=ollama

UPSTREAM_TIMEOUT_SECONDS=18
MAX_MESSAGES=12
MAX_CONTENT_CHARS=6000
